---
import ThemeToggle from './ThemeToggle.astro';
import { content, repository, type Locale } from '../data/content';
import { localPath } from '../lib/paths';
interface Props {
  locale: Locale;
  guide?: boolean;
}
const { locale, guide = false } = Astro.props;
const t = content[locale];
---

<footer class="page-width footer">
  <div class="footer-controls flex items-center gap-7">
    <a class="repository-link" href={repository}
      >GitHub <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"
        ><path
          d="M6 18 18 6M6 6h12v12"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"></path></svg
      ></a
    >
    <ThemeToggle locale={locale} />
    <nav class="language-switch flex" aria-label={t.language}>
      <a
        href={localPath(guide ? 'guide/' : '')}
        lang="en"
        hreflang="en"
        aria-label="English"
        aria-current={locale === 'en' ? 'page' : undefined}>EN</a
      >
      <a
        href={localPath(guide ? 'es/guide/' : 'es/')}
        lang="es"
        hreflang="es"
        aria-label="Español"
        aria-current={locale === 'es' ? 'page' : undefined}>ES</a
      >
    </nav>
  </div>
  <div class="footer-top flex flex-wrap items-center justify-between gap-6">
    <a class="footer-wordmark" href="#top" aria-label={t.back}>pacifico</a>
    <p>{t.footerNote}</p>
  </div>
  <div class="footer-bottom flex flex-col gap-2">
    <p>{t.credit} <a href="https://github.com/nicknisi/sessions">nicknisi/sessions</a>.</p>
    <p>{t.made} <a href="https://github.com/emersoftware">emersoftware</a>.</p>
  </div>
</footer>
