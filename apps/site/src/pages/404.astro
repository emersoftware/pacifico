---
import Page from '../layouts/Page.astro';
import { localPath } from '../lib/paths';
---

<Page locale="en" title="Page not found | pacifico">
  <main id="main" class="page-width missing-page">
    <p class="footer-wordmark">pacifico</p>
    <h1 class="section-title">This page isn’t here.<br /><span lang="es">Esta página no está aquí.</span></h1>
    <a class="text-link" href={localPath()}>Back to Pacifico</a>
    <a class="text-link" lang="es" href={localPath('es/')}>Volver a Pacifico</a>
  </main>
</Page>
